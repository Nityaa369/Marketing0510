# Copy to .env (setup_mac.sh does this). No secrets are needed: everything runs locally.

# mflux = local AI on Apple Silicon; placeholder = labelled stand-in image for testing
STUDIO_HERO_BACKEND=mflux

# Model: mflux name (z-image-turbo = Tongyi-MAI/Z-Image-Turbo, Apache-2.0), a Hugging Face repo id, or a local folder.
STUDIO_MODEL=z-image-turbo
# Quantize while loading: 8 (24 GB+ RAM), 4 (16 GB RAM), none (model already quantized)
STUDIO_QUANTIZE=8
STUDIO_STEPS=9

# Advanced: the exact command used per image. {placeholders} are filled in by the studio.
# STUDIO_MFLUX_COMMAND=mflux-generate-z-image-turbo --model {model} --prompt {prompt} --width {width} --height {height} --seed {seed} --steps {steps} {quantize_flag} --output {output}

# Optional: where Hugging Face stores weights (default ~/.cache/huggingface)
# HF_HOME=/Volumes/External/hf
